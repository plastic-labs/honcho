{
  "name": "honcho-mcp",
  "version": "3.4.0",
  "description": "Honcho MCP Server",
  "main": "src/index.ts",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||'';if(ua.includes('npm')&&!ua.includes('bun')){console.error('❌ Please use bun instead of npm!\\n📦 Run: bun install\\n🌐 Install bun: https://bun.sh/');process.exit(1)}\"",
    "dev": "wrangler dev",
    "stdio": "bun src/stdio.ts",
    "http": "bun src/http.ts",
    "typecheck": "tsc --noEmit",
    "check:deploy": "bun install --frozen-lockfile && tsc --noEmit",
    "deploy": "bun run check:deploy && wrangler deploy",
    "deploy:staging": "bun run check:deploy && wrangler deploy --env staging",
    "dev:codemode": "wrangler dev -c wrangler.codemode.toml",
    "deploy:codemode": "bun run check:deploy && wrangler deploy -c wrangler.codemode.toml"
  },
  "dependencies": {
    "@cloudflare/codemode": "0.5.6",
    "@honcho-ai/sdk": "^2.9.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@sentry/bun": "^11.1.0",
    "@sentry/cloudflare": "^11.1.0",
    "agents": "0.33.0",
    "nanoid": "^5.1.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "typescript": "^5.3.3",
    "wrangler": "4.163.0"
  }
}
